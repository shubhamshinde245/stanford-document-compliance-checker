# Stanford AI API Gateway — one key for GPT, Claude, Gemini, and other models.
# Paste the key after the equals sign. Do not commit .env.local.

AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=https://aiapi-dev.stanford.edu/

# LLM router. stanford is the live default. openai and anthropic are fallbacks
# when those keys are set. Ollama is a Settings placeholder only.
LLM_PROVIDER=stanford
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Official SANS / CRF security policy templates (standards library).
SANS_BASE_URL=https://www.sans.org/information-security-policy
